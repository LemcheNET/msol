{
  "manifest_version": 3,
  "name": "msol: open Microsoft apps in their own windows",
  "version": "1.0",
  "description": "When a Microsoft app window opens another Microsoft app (for example from the app launcher menu), open it as its own app window instead of a browser tab.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs", "webNavigation",
    "nativeMessaging"
  ]
}
