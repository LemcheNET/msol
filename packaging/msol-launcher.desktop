[Desktop Entry]
Type=Application
Version=1.0
Name=Microsoft 365 Launcher
Comment=Start screen for Microsoft web apps, each in its own window (msol)
Exec=/usr/lib/msol/msol-launcher.py
TryExec=/usr/lib/msol/msol-launcher.py
Icon=applications-office
Terminal=false
Categories=Office;Network;
StartupNotify=true
StartupWMClass=msol-launcher
